{
  "name": "colour-reduction",
  "version": "1.0.56",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm version patch --no-git-tag-version && next dev",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:all": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "build": "next build",
    "start": "next start",
    "dist": "npm version patch --no-git-tag-version && node -e \"const fs=require('fs');const p='release';if(fs.existsSync(p)){fs.readdirSync(p).filter(f=>f.endsWith('.exe')||f.endsWith('.blockmap')||f.endsWith('.yaml')).forEach(f=>fs.rmSync(p+'/'+f,{force:true}));}\" && electron-builder --win"
  },
  "build": {
    "appId": "com.colourreduction.app",
    "productName": "Colour Reduction",
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.png"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "ColorReduction (8).html",
      "package.json",
      "!node_modules/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "electron/installer.nsh"
    }
  },
  "dependencies": {
    "lucide-react": "^0.359.0",
    "next": "^14.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3",
    "wait-on": "^7.2.0"
  }
}
